# Database (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://<db_user>:<db_password>@<db_host>:5432/<db_name>"
DATABASE_URL_SYNC="postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>"

# JWT Settings
TOKEN_EXPIRE=60                     # Token expiration in minutes
TOKEN_EMAIL_EXPIRE=15               # Email token expiration in minutes
SECRET_KEY_JWT=<your_jwt_secret>
ALGORITM_JWT=HS256

# Permissions
PATH_TO_PERMISSION_JSON=permission.json

# RabbitMQ
RABBITMQ_URL=amqp://<rabbit_user>:<rabbit_password>@<rabbit_host>:5672/

# Email SMTP Settings
EMAIL_SENDER=<your_email@example.com>
PASSWD_EMAIL_SENDER=<your_email_app_password>
EMAIL_SERVER_ADDR=<smtp_host>
EMAIL_SERVER_PORT=587

# MinIO / AWS S3-compatible
AWS_URL=http://<minio_host>:9000
AWS_ACCESS_KEY_ID=<your_aws_access_key>
AWS_SECRET_ACCESS_KEY=<your_aws_secret_key>
EXTERNAL_HOST_AWS=http://<external_host>:9000/